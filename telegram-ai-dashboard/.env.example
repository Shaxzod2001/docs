# ===== REJIM TANLASH =====
# A) BOT REJIMI (oson) - faqat bot token kerak, my.telegram.org SHART EMAS
# B) TO'LIQ REJIM - user akkaunt (API_ID/HASH). Obunachilar ro'yxati ham ishlaydi.
# Agar API_ID/HASH to'ldirilsa - to'liq rejim, aks holda - bot rejimi ishlaydi.

# ----- BOT REJIMI uchun (@BotFather dan) -----
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ----- TO'LIQ REJIM uchun (my.telegram.org dan, IXTIYORIY) -----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_NAME=user_session

# Kanal username (@kanal) yoki -100... ID
TELEGRAM_CHANNEL=@your_channel

# ===== Groq AI (console.groq.com dan BEPUL oling) =====
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Kanal sozlamalari =====
CHANNEL_TOPIC=Kiberxavfsizlik va IT
CHANNEL_LANGUAGE=uz

# Avtomatik post vaqtlari (HH:MM, vergul bilan)
AUTO_POST_TIMES=09:00,14:00,18:00

# Statistika necha daqiqada yangilansin
STATS_REFRESH_MINUTES=30

# ===== Veb server =====
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Ma'lumotlar bazasi
DATABASE_PATH=dashboard.db
