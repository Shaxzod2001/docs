# ===== Telegram user akkaunt (my.telegram.org dan oling) =====
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+998901234567

# Kanal username (@kanal) yoki -100... ID
TELEGRAM_CHANNEL=@your_channel

# Sessiya fayl nomi (o'zgartirmasangiz ham bo'ladi)
SESSION_NAME=user_session

# ===== Groq AI (console.groq.com dan BEPUL oling) =====
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Kanal sozlamalari =====
CHANNEL_TOPIC=Kiberxavfsizlik va IT
CHANNEL_LANGUAGE=uz

# Avtomatik post vaqtlari (HH:MM, vergul bilan)
AUTO_POST_TIMES=09:00,14:00,18:00

# Statistika necha daqiqada yangilansin
STATS_REFRESH_MINUTES=30

# ===== Veb server =====
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Ma'lumotlar bazasi
DATABASE_PATH=dashboard.db
