# Telegram bot tokeni (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Kanal ID si (masalan: @mening_kanalim yoki -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_username

# Anthropic Claude API kaliti (console.anthropic.com dan oling)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Admin foydalanuvchilar ID lari (vergul bilan ajratilgan)
# Telegram ID ni @userinfobot dan olish mumkin
ADMIN_USER_IDS=123456789,987654321

# Kanalingiz mavzusi
CHANNEL_TOPIC=Ta'lim va o'rganish

# Til (uz = o'zbek, ru = rus, en = ingliz)
CHANNEL_LANGUAGE=uz

# Kuniga nechta post (2-4 orasida tavsiya qilinadi)
POSTS_PER_DAY=3

# RSS yangilik manbalari (ixtiyoriy, vergul bilan ajratilgan)
RSS_FEEDS=https://example.com/feed.rss,https://example2.com/rss

# Ma'lumotlar bazasi fayli nomi
DATABASE_PATH=bot_data.db
