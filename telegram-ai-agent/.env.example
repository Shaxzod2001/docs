# Telegram bot tokeni (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Kanal username yoki ID
TELEGRAM_CHANNEL_ID=@your_channel_username

# Ollama API kaliti (ollama.com/settings/keys dan oling - BEPUL)
OLLAMA_API_KEY=your_ollama_api_key_here

# Admin Telegram ID (t.me/userinfobot dan oling)
ADMIN_USER_IDS=123456789

# Kanal mavzusi
CHANNEL_TOPIC=Kiberxavfsizlik va IT

# Til (uz / ru / en)
CHANNEL_LANGUAGE=uz

# Kuniga nechta post
POSTS_PER_DAY=3

# Ma'lumotlar bazasi
DATABASE_PATH=bot_data.db
